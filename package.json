{
  "name": "junglegaming-frontend-challenge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.ts",
    "images": "node scripts/convert-images.ts",
    "build:e2e": "vite build --mode test --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@iconify/react": "^6.0.3",
    "@radix-ui/react-slider": "^1.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.0",
    "big.js": "^7.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/basil": "^1.2.4",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/logos": "^1.2.18",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/solar": "^1.2.13",
    "@iconify-json/token-branded": "^1.2.46",
    "@iconify/utils": "^3.1.7",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lighthouse": "^13.6.0",
    "msw": "^3.0.3",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@mswjs/socket.io-binding": {
      "msw": "$msw"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
